generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  FACULTY
  STUDENT
}

enum EventCategory {
  TECHNICAL
  CULTURAL
  SPORTS
  WORKSHOP
  SEMINAR
  OTHER
}

enum EventStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  department   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  organizedEvents Event[]        @relation("OrganizerEvents")
  reviewedEvents  Event[]        @relation("ReviewerEvents")
  registrations   Registration[]
}

model Venue {
  id       String  @id @default(cuid())
  name     String  @unique
  capacity Int
  events   Event[]
}

model Event {
  id           String        @id @default(cuid())
  title        String
  description  String
  category     EventCategory
  posterUrl    String?
  venueId      String
  startsAt     DateTime
  endsAt       DateTime
  capacity     Int
  status       EventStatus   @default(DRAFT)
  reviewRemark String?
  organizerId  String
  reviewedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  venue         Venue          @relation(fields: [venueId], references: [id])
  organizer     User           @relation("OrganizerEvents", fields: [organizerId], references: [id])
  reviewedBy    User?          @relation("ReviewerEvents", fields: [reviewedById], references: [id])
  registrations Registration[]
}

model Registration {
  id             String    @id @default(cuid())
  eventId        String
  userId         String
  createdAt      DateTime  @default(now())
  attendedAt     DateTime?
  reminderSentAt DateTime?

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback Feedback?

  @@unique([eventId, userId])
}

model Feedback {
  id             String       @id @default(cuid())
  registrationId String       @unique
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now())

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}
